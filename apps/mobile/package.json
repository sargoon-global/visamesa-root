{
  "name": "@visamesa/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "adb:reverse": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:5173 tcp:5173 && adb reverse tcp:8081 tcp:8081",
    "android": "npm run adb:reverse && react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "test:ci": "npm ci --prefix ../../shared/content && npm ci --prefix ../../shared/design-tokens && npm test --prefix ../../shared/content && npm test --prefix ../../shared/design-tokens && npm run lint && npm test -- --forceExit && npm run type-check",
    "pdf:schema": "node src/features/pdfGeneration/tools/generate-pdf-form-schema.mjs",
    "pdf:blank": "node src/features/pdfGeneration/tools/generate-renamed-blank-pdf.mjs",
    "pdf:fill:ex17": "node src/features/pdfGeneration/tools/fill-ex17-pdf.mjs",
    "link-assets": "react-native-asset",
    "postinstall": "react-native-asset"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@react-native-async-storage/async-storage": "3.1.0",
